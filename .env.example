# LLM API Key — pick one provider.
# With no override CodeABC uses gpt-5-mini, so an OpenAI key works out of the box.
OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# DEEPSEEK_API_KEY=xxx
# OPENROUTER_API_KEY=sk-or-xxx   # one key that reaches every provider

# To use any provider other than OpenAI, also point CODEABC_MODEL at one of its
# models (the value is handed straight to litellm).
# CODEABC_MODEL=deepseek/deepseek-chat
# CODEABC_MODEL=openrouter/anthropic/claude-haiku-4.5

# Frontend origin for CORS (default: http://localhost:5173)
# FRONTEND_ORIGIN=https://your-domain.com
